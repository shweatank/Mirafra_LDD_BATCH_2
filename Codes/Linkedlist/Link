struct node * DeleteatBeg(struct node *head)
{
    struct node *temp;
    temp = head;
    head = head->link;
    free(temp);
    
    return head;
}
struct node * DeleteatEnd(struct node *head)
{
    struct node *temp,*prev;
    temp = head;
    if(head == NULL)
    {
        printf("List is Empty");
        
    }
    else
    {
        while(temp->link!=NULL)
        {
            prev = temp;
            temp = temp->link;
        }
        prev->link = NULL;
    }
    free(temp);
    return head;
}


struct node * DeleteatspecificPosition(struct node *head,int pos)
{
    int i=1;
    struct node *temp,*next;
    temp = head;
    if(i<pos-1)
    {
        temp = temp->link;
        i++;
    }
    next = temp->link;
    temp->link = next->link;
    free(next);
    
    return head;
    
}
struct node *Reverse(struct node *head)
{
    struct node *current,*prev,*next;
    current = next = head;
    prev = 0;
    while(next!=0)
    {
        next = next->link;
        current ->link = prev;
        prev = current;
        current = next;
    }
    return prev;
}
